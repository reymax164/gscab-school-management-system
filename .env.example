APP_NAME="GSCAB School System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://gscab-school-management-system.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=# value here
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.# value here
DB_PASSWORD=# value here

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=# value here
AWS_SECRET_ACCESS_KEY=# value here
AWS_DEFAULT_REGION=# value here
AWS_BUCKET=# value here
AWS_ENDPOINT=# value here
AWS_USE_PATH_STYLE_ENDPOINT=true

QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=# value here
MAIL_PASSWORD=# value here
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME="GSCAB School System"